# Local PostgreSQL from docker compose. For hosted deployments use your provider's
# pooled URL for DATABASE_URL and direct/session URL for DIRECT_URL (migrations).
DATABASE_URL="postgresql://postgres:postgrespassword@127.0.0.1:5432/chickentinder?schema=public&connection_limit=5&pool_timeout=10"
DIRECT_URL="postgresql://postgres:postgrespassword@127.0.0.1:5432/chickentinder?schema=public"
# Tests require an explicit disposable database; each run creates its own schema.
TEST_DATABASE_URL="postgresql://postgres:postgrespassword@127.0.0.1:5432/chickentinder"
