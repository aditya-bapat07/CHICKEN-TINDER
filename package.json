{
  "name": "chicken-tinder-api",
  "version": "1.0.0",
  "description": "Chicken Tinder API - Boredom solver with forced commitment mechanism",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "prisma generate && tsc && npm --prefix frontend run build",
    "start": "node dist/server.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "test": "node scripts/run-tests.mjs",
    "dev:api": "tsx watch src/server.ts",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:api": "tsc",
    "test:e2e": "npm run build && node scripts/run-tests.mjs --browser",
    "setup": "npm install --prefix frontend && prisma db push && npm run db:seed",
    "format": "prettier --write \"src/**/*.ts\" \"frontend/src/**/*.{ts,tsx,css}\" \"scripts/*.{ts,mjs}\" playwright.config.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "@prisma/client": "^6.4.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^4.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.13.5",
    "prettier": "^3.9.8",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
