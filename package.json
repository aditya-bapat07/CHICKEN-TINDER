{
  "name": "chicken-tinder-api",
  "version": "1.0.0",
  "description": "Chicken Tinder API - Boredom solver with forced commitment mechanism",
  "main": "backend/dist/server.js",
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "prisma generate --schema database/prisma/schema.prisma && tsc && npm --prefix frontend run build",
    "vercel:build": "node scripts/vercel-build.mjs",
    "test:deployment": "node --test tests/deployment-env.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "start": "node backend/dist/server.js",
    "db:push": "prisma db push --schema database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema database/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema database/prisma/schema.prisma",
    "db:seed": "tsx database/prisma/seed.ts",
    "test": "node scripts/run-tests.mjs",
    "dev:api": "tsx watch backend/src/server.ts",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:api": "tsc",
    "test:e2e": "npm run build && node scripts/run-tests.mjs --browser",
    "setup": "npm ci --prefix frontend && npm run db:deploy && npm run db:seed",
    "format": "prettier --write \"backend/src/**/*.ts\" \"database/prisma/*.ts\" \"frontend/src/**/*.{ts,tsx,css}\" \"scripts/*.{ts,mjs}\" playwright.config.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/helmet": "^13.1.1",
    "@prisma/client": "6.19.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^4.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.13.5",
    "prettier": "^3.9.8",
    "prisma": "6.19.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
